<Project>

  <PropertyGroup>
    <!-- 编译期引用: SDK 从 refs\ 取, 游戏程序集从 refs\game\ 取 (都由 tools/fetch-refs.ps1 准备) -->
    <CesiumSdkDir Condition="'$(CesiumSdkDir)' == ''">$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)refs'))</CesiumSdkDir>
    <GameRefsDir Condition="'$(GameRefsDir)' == '' and '$(CESIUM_GAME_REFS)' != ''">$([MSBuild]::EnsureTrailingSlash('$(CESIUM_GAME_REFS)'))</GameRefsDir>
    <GameRefsDir Condition="'$(GameRefsDir)' == ''">$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)refs\game'))</GameRefsDir>
  </PropertyGroup>

  <Target Name="RandomHeroSelectVerifyReferencePaths" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_RandomHeroSelectMissingReference Include="@(Reference)"
                                         Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')" />
    </ItemGroup>
    <Error Condition="'@(_RandomHeroSelectMissingReference)' != ''"
           Text="RandomHeroSelectMod: 缺少引用的程序集 @(_RandomHeroSelectMissingReference->'%(HintPath)', '; ')。请先运行 pwsh -File tools\fetch-refs.ps1 准备 refs\（或用 CESIUM_GAME_REFS 指向已提取的游戏程序集目录）。" />
  </Target>

</Project>
